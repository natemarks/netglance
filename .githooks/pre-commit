#!/bin/bash
# Pre-commit hook for netglance
# Runs gitleaks to prevent secrets from being committed

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}🔍 Running gitleaks secret scan...${NC}"

# Check if gitleaks is installed
if ! command -v gitleaks &> /dev/null; then
    echo -e "${RED}✗ Error: gitleaks not installed${NC}"
    echo ""
    echo "Install gitleaks:"
    echo "  macOS:   brew install gitleaks"
    echo "  Linux:   https://github.com/gitleaks/gitleaks#installing"
    echo ""
    echo "Or skip this hook (not recommended):"
    echo "  git commit --no-verify"
    exit 1
fi

# Run gitleaks on staged changes
if gitleaks protect --verbose --staged; then
    echo -e "${GREEN}✓ No secrets detected${NC}"
    exit 0
else
    echo ""
    echo -e "${RED}✗ Secrets detected in staged changes!${NC}"
    echo ""
    echo "Fix the issues above, or if this is a false positive:"
    echo "  1. Add an allowlist entry to .gitleaks.toml"
    echo "  2. Or skip this hook: git commit --no-verify"
    echo ""
    exit 1
fi
